{
  "name": "dsh-fengcha",
  "version": "2.0.0",
  "type": "module",
  "description": "Fengcha 2.0 — DeepSeek Harness agent presets that make the model reason in the first person plural (We need / Our). Two presets: 风插标准 (standard) and 风插 PTC. Hard-instruction constraint, not an attractor; no capability claim.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "prompt",
    "reasoning-register"
  ],
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node check-yaml.mjs",
    "build:presets": "node build-presets.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
